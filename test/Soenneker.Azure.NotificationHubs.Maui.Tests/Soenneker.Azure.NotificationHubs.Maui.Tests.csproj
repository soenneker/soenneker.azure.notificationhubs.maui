<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);CA1416;CA1418</NoWarn>
        <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.Test" Version="4.0.324" />
        <PackageReference Include="Soenneker.Tests.HostedUnit" Version="4.0.204" />
        <PackageReference Include="TUnit" Version="1.65.63" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Azure.NotificationHubs.Maui\Soenneker.Azure.NotificationHubs.Maui.csproj" />
    </ItemGroup>

</Project>
